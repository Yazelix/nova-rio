<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
   <Package
      Name="Nova Rio"
      UpgradeCode="f3852c26-be09-4533-b49d-a1a6a98491f9"
      Language="1033"
      Codepage="1252"
      Version="{{ .Version }}"
      Manufacturer="Raphael Amorim"
      InstallerVersion="200">

      <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
      <WixVariable Id="WixUILicenseRtf" Value=".\misc\windows\License.rtf" />
      <Icon Id="RioIcon" SourceFile=".\misc\windows\rio.ico" />
      <Property Id="APPRODUCTICON" Value="RioIcon" />
      <MediaTemplate EmbedCab="yes" />
      <ui:WixUI Id="WixUI_Minimal" />
      <Feature Id="ProductFeature" Title="ConsoleApp" Level="1">
         <ComponentRef Id="RioExe" />
         <ComponentRef Id="RioShortcut" />
         <ComponentRef Id="ModifyPathEnv" />
         <ComponentRef Id="ContextMenu" />
      </Feature>
      <!-- Application binaries -->
      <DirectoryRef Id="RioProgramFiles">
         <Component Id="RioExe">
            <File Id="RioExeFile" Source="{{ .Binary }}.exe" Name="nrio.exe" KeyPath="yes" />
         </Component>
      </DirectoryRef>
      <DirectoryRef Id="RioProgramMenu">
         <!-- Application shortcut -->
         <Component Id="RioShortcut" Guid="03eba745-707f-4e8e-933f-9b16f5b08f5e">
            <Shortcut Id="RioShortcutFile" Name="Nova Rio" Description="A hardware-accelerated GPU terminal emulator" Target="[RioProgramFiles]nrio.exe" Icon="RioIcon" />
            <RemoveFolder Id="RioProgramMenu" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Yazelix\NovaRio" Name="installed" Type="integer" Value="1" KeyPath="yes" />
         </Component>
      </DirectoryRef>
      <DirectoryRef Id="RioProgramFiles">
         <!-- Add to PATH -->
         <Component Id="ModifyPathEnv" Guid="effabd51-5e02-459f-a873-ac6d49cb138d" KeyPath="yes">
            <Environment Id="PathEnv" Value="[RioProgramFiles]" Name="PATH" Permanent="no" Part="first" Action="set" System="yes" />
         </Component>
      </DirectoryRef>
      <StandardDirectory Id="ProgramFiles64Folder">
         <Directory Id="RioProgramFiles" Name="Nova Rio" />
      </StandardDirectory>
      <StandardDirectory Id="ProgramMenuFolder">
         <Directory Id="RioProgramMenu" Name="Nova Rio" />
      </StandardDirectory>
      <!-- Add context menu -->
      <Component Id="ContextMenu" Guid="ed91604c-3464-4601-8d40-02e5bc7b954b" Directory="TARGETDIR">
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open Nova Rio here\command">
            <RegistryValue Type="string" Value='[RioProgramFiles]nrio.exe --working-dir "%v"' KeyPath="yes" />
         </RegistryKey>
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open Nova Rio here">
            <RegistryValue Type="string" Name="Icon" Value="[RioProgramFiles]nrio.exe" />
         </RegistryKey>
      </Component>
   </Package>
</Wix>
